# Hyperliquid Multi-Timeframe SMC Trading Bot Configuration

# Environment: "testnet" or "mainnet"
HYPERLIQUID_ENV=testnet

# Your Ethereum wallet private key (starts with 0x) or Hyperliquid Agent API Key
# NEVER share this key. For Testnet, you can use any testnet private key.
# For Mainnet, we recommend creating an API Agent in Hyperliquid UI -> API Agents.
HYPERLIQUID_PRIVATE_KEY=

# Optional: Account address if trading on behalf of a vault or agent
HYPERLIQUID_ACCOUNT_ADDRESS=

# Trading Mode:
# Set to true for paper trading (no real orders sent to Hyperliquid exchange)
# Set to false to execute real orders via Hyperliquid API
DRY_RUN=true

# Automated Execution Toggle:
# If true, the bot will automatically enter trades when MTF SMC setups are confirmed
AUTO_TRADE_ENABLED=true

# Trading Pairs (comma-separated)
TRADING_SYMBOLS=BTC,ETH,SOL

# Risk Management Settings (Optimized for $10 - $20 balance)
# Maximum balance to risk per trade (in USD, e.g., 1.0 = $1.00 risk)
RISK_USD_PER_TRADE=1.00

# Minimum order notional required by Hyperliquid (default is $11 to be safely above $10 min)
MIN_ORDER_NOTIONAL=11.0

# Leverage to set on Hyperliquid perps
LEVERAGE=3

# Target Risk-to-Reward ratio for Take Profit (e.g., 2.0 = 1:2 R:R, 3.0 = 1:3 R:R)
TARGET_RR=2.5

# Stop Loss buffer percentage beyond the 15m sweep wick (0.001 = 0.1%)
SL_BUFFER_PCT=0.001

# Dashboard Server Port
DASHBOARD_PORT=8000
